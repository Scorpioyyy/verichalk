# 复制为 .env 使用（.env 不入库）。密钥只放环境变量或 .env，绝不写入代码、日志或提交。

# 模型 profile：cn（国内节点）| intl（新加坡节点，部署用）
VERICHALK_PROFILE=intl

# 国内节点
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# 新加坡节点
DASHSCOPE_INTL_API_KEY=
DASHSCOPE_INTL_BASE_URL=

# 运行时数据目录（SQLite、上传、导出）；默认仓库根目录下的 data/
# VERICHALK_DATA_DIR=

# 调试台令牌：生产环境必须设置；本地不设置时仅允许 127.0.0.1 访问
# VERICHALK_DEBUG_TOKEN=

# 模型调用模式：live | record | replay | replay_or_live | replay_or_record（评测用）
# VERICHALK_LLM_MODE=live

# 临时覆盖某个角色使用的模型（评测对比用）
# VERICHALK_MODEL_FAST=
